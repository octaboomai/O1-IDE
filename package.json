{
  "name": "o1-ide-desktop",
  "version": "0.1.1",
  "author": "octaboomai <hello@o1ide.dev>",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "o1-app",
    "o1-extension"
  ],
  "scripts": {
    "build": "yarn workspace o1-extension build && yarn workspace o1-app build",
    "build:prod": "yarn workspace o1-extension build && yarn workspace o1-app build:prod",
    "dist:linux": "yarn build:prod && electron-builder --linux deb AppImage",
    "dist:windows": "yarn build:prod && electron-builder --win nsis",
    "start": "yarn workspace o1-app start",
    "clean": "yarn workspace o1-extension clean && yarn workspace o1-app clean"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "electron-updater": "^6.3.9",
    "electron": "42.8.1"
  },
  "main": "o1-app/lib/backend/electron-main.js",
  "overrides": {
    "electron": "42.8.1"
  },
  "theiaPluginsDir": "o1-app/plugins",
  "theiaPlugins": {
    "magicstack.MagicPython": "https://open-vsx.org/api/magicstack/MagicPython/1.1.1/file/magicstack.MagicPython-1.1.1.vsix",
    "jeff-hykin.better-cpp-syntax": "https://open-vsx.org/api/jeff-hykin/better-cpp-syntax/1.27.1/file/jeff-hykin.better-cpp-syntax-1.27.1.vsix",
    "twxs.cmake": "https://open-vsx.org/api/twxs/cmake/0.0.17/file/twxs.cmake-0.0.17.vsix",
    "DotJoshJohnson.xml": "https://open-vsx.org/api/DotJoshJohnson/xml/2.5.1/file/DotJoshJohnson.xml-2.5.1.vsix"
  }
}
